# Environment for cron jobs (dcron does not inherit the daemon PATH reliably)
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# HAOS Weekly Updater - runs every Tuesday at 08:00 (Kyiv time)
0 8 * * 2 /update-script.sh

